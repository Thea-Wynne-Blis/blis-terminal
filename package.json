{
  "name": "blis-terminal",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @blis/desktop dev",
    "build": "pnpm --filter @blis/desktop build",
    "bundle": "pnpm --filter @blis/desktop exec tauri build -- --locked",
    "tauri": "pnpm --filter @blis/desktop tauri",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-vue": "^10.7.0",
    "prettier": "^3.7.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.50.0",
    "vitest": "^4.0.0"
  }
}
